# Required for live LLM calls
GROQ_API_KEY=

# Required for live Supabase invoice/customer lookups
SUPABASE_URL=
SUPABASE_KEY=

# Stripe must use a test-mode secret key (sk_test_...)
STRIPE_SECRET_KEY=

# Optional: required only for live confirmation emails
RESEND_API_KEY=
RESEND_FROM_EMAIL=Ticket Flow <onboarding@resend.dev>

# Optional LangSmith tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ticket-flow

# Runtime configuration
TICKETFLOW_ENV=development
LOG_LEVEL=INFO
CHECKPOINTER_BACKEND=memory
CHECKPOINT_DB_PATH=data/checkpoints.sqlite
PERSIST_REFUNDS=false
REDIS_URL=redis://localhost:6379/0
ENABLE_MOCK_ROUTES=true
DELIVER_ESCALATIONS=false
ZENDESK_BASE_URL=http://localhost:8000/mock/zendesk
